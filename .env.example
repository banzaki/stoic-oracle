# Copy this file to .env.local and fill in your key.
# The key is read only by the server routes (src/app/api/) and is never sent to the browser.
ANTHROPIC_API_KEY=

# Optional. Spending guard (defaults shown). The daily budget is estimated from token usage;
# also set a monthly spend limit in the Anthropic Console as the hard ceiling.
# DAILY_BUDGET_USD=2
# REPLIES_PER_VISITOR_HOUR=30
# TRANSLATIONS_PER_VISITOR_HOUR=120

# Optional. Set to "off" to skip semantic re-ranking of retrieved passages (keyword order only).
# RERANK=on

# Optional. Public address of the site, for absolute share-image URLs (Vercel provides one automatically).
# SITE_URL=https://example.com
