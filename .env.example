# Copy this file to .env.local and fill in your key.
# The key is read only by the server routes (src/app/api/) and is never sent to the browser.
ANTHROPIC_API_KEY=

# Shared store for the spending guard (Upstash Redis). Required on Vercel: without it the
# chat refuses to run there. Locally, counters fall back to process memory.
# The Vercel Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; both work.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional. Spending guard (defaults shown). Also set a monthly spend limit in the Anthropic Console.
# DAILY_BUDGET_USD=2          # global budget per UTC day, estimated from token usage
# REPLIES_PER_HOUR=6          # per visitor; a Council question counts one reply per speaker
# REPLIES_PER_DAY=10
# COUNCILS_PER_DAY=2
# ADDRESS_FACTOR=2            # an IP address may be shared, so it gets this many visitors' allowance
# LIMITS_SALT=                # any random string; visitor ids and addresses are stored hashed with it
# ORACLE_PAUSED=1             # refuse all model calls (or: npm run oracle -- pause, no redeploy)

# Optional. Set to "off" to skip semantic re-ranking of retrieved passages (keyword order only).
# RERANK=on

# Optional. Public address of the site, for absolute share-image URLs (Vercel provides one automatically).
# SITE_URL=https://example.com
